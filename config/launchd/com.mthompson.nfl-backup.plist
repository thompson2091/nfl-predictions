<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.mthompson.nfl-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/make</string>
    <string>-C</string>
    <string>/Users/mthompson/projects/personal/nfl-predictions</string>
    <string>backup-odds</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/mthompson/projects/personal/nfl-predictions</string>
  <!-- A timestamped copy of every archive nothing can re-fetch, nightly.
       `backup-odds` skips a file identical to its newest copy and keeps the
       last 14 of each, so a quiet night writes nothing. Same disk: this
       protects against a bad write, not a lost laptop. -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>15</integer></dict>
  <key>StandardOutPath</key>
  <string>/Users/mthompson/projects/personal/nfl-predictions/logs/launchd_backup.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/mthompson/projects/personal/nfl-predictions/logs/launchd_backup.err</string>
</dict>
</plist>
