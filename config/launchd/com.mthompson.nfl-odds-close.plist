<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.mthompson.nfl-odds-close</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/mthompson/projects/personal/nfl-predictions/scripts/weekly_odds.sh</string>
    <string>close</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/mthompson/projects/personal/nfl-predictions</string>
  <!-- Generated by scripts/25_odds_schedule.py from the season's kickoffs.
       Edit that, not this: a hand-edited slot is silently wrong the first time
       the league flexes a game. Slots are deliberately generous; weekly_odds.sh
       exits without spending an API credit when no kickoff is near. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>12</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>35</integer></dict>
    <dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>50</integer></dict>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>12</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>12</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>14</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>16</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>19</integer><key>Minute</key><integer>50</integer></dict>
  </array>
  <!-- If the Mac is asleep at the scheduled time, launchd runs the job as soon
       as it wakes. cron would simply skip it, and a skipped capture is a price
       that cannot be bought back. -->
  <key>StandardOutPath</key>
  <string>/Users/mthompson/projects/personal/nfl-predictions/logs/launchd_close.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/mthompson/projects/personal/nfl-predictions/logs/launchd_close.err</string>
</dict>
</plist>
