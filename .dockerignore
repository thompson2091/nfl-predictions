# Version control / tooling
.git
.gitignore
.dockerignore
Dockerfile
docker-compose*.yml
.claude
.agents
.playwright-mcp

# Local Python environments and build artifacts
.venv
**/__pycache__
**/*.pyc
*.egg-info
.ipynb_checkpoints
notebooks

# Secrets never belong in an image layer
.env
.env.*
!.env.example

**/.DS_Store

# Raw pulls are large; the pipeline entrypoint regenerates them via `ingest`.
# Only what the *app* reads at serve time is baked in. That list grew without
# this file noticing: load_graded_history resolves player ids through rosters,
# and the availability check reads injuries. Excluding them did not fail the
# build or the bind-mounted dev container — only `docker compose --profile prod`
# and any real deploy, where the app died on a missing rosters.parquet.
#
# pbp.parquet (135M) and the other feature-building pulls stay out.
data/raw/*
!data/raw/schedules.parquet
!data/raw/rosters.parquet
!data/raw/injuries.parquet
!data/raw/player_td_odds.parquet
!data/raw/odds_cache
!data/raw/odds_cache/**
