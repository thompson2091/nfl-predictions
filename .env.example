# Copy to .env and fill in. All keys are optional.
# ANTHROPIC_API_KEY enables AI edge analysis; ODDS_API_KEY enables live TD props;
# TAVILY_API_KEY enables real-time web lookups during market review.
ANTHROPIC_API_KEY=
ODDS_API_KEY=
TAVILY_API_KEY=

# Optional host port overrides for docker compose
# APP_PORT=8501
# PROD_PORT=8502
