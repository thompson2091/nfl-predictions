#
# THE PAGE AND ITS DATA MUST REVALIDATE ON EVERY LOAD.
#
# Apache was serving index.html with an ETag and a Last-Modified and no
# Cache-Control, so browsers cached it heuristically: a deploy landed, the
# live file changed, and the reader kept seeing the previous build with no
# way of knowing. `no-cache` does NOT mean "do not store" — it means "ask
# before reusing", so an unchanged page still costs a 304 and nothing more.
#
# The service worker is network-first and was never the problem; this is the
# layer underneath it.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|json|webmanifest)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # The worker itself is the one file a stale copy is unrecoverable from: it
  # decides how everything else is fetched.
  <FilesMatch "sw\.js$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# The ask proxy posts JSON and answers JSON; nothing else should reach it.
<FilesMatch "ask\.php$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-store"
  </IfModule>
</FilesMatch>
