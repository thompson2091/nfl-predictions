data/
models/*.pkl

# Locked version snapshots. Weights are regenerable and ~3.3 MB a version; the
# manifests under models/registry/ are neither, so those stay in git and carry
# the metrics, config and git SHA that make a version identifiable.
# `models/*.pkl` above does not cover nested paths.
models/versions/
# The three yardage models, for the same reason and more so. A quantile model
# is one booster per fitted level, so `xgb_quantile.pkl` is 21 of them: 17 MB
# for passing yards, 31 for receiving, 51 for rushing — 99 MB a retrain,
# against a 22 MB repository. They are regenerable by
# `scripts/49_yards.py` in about twenty minutes, and what is NOT regenerable
# is the fitted blend weight beside them, which is a few hundred bytes of JSON
# and stays in git.
models/*_yards/*.pkl
output/
__pycache__/
*.pyc
.venv/
*.egg-info/
.ipynb_checkpoints/
.env

# Streamlit secrets must never be committed; config.toml is the theme and should be.
.streamlit/secrets.toml

# Browser-test artifacts. Regenerated on every UI check and worthless afterwards;
# ~90 of them had accumulated untracked before this line existed.
.playwright-mcp/

# Screenshots taken while verifying the app.
/*.png

# Unattended cron output from scripts/weekly_odds.sh.
logs/
.claude/skills/*/.streamlit/

# Built by `make launch`; disposable, rebuilt every time.
public/
data/raw/game_notes_cache/

# graphify builds a code graph under graphify-out/. It is a derived artifact:
# rebuildable from the source with `graphify . --update`, and it churns on every
# rebuild, so committing it would add noise to every diff.
graphify-out/
deploy/history/

# QA-Agent output; the config and plugin under qa/ are committed.
qa/qa-reports/
qa/.qa-agent/
qa/qa-triage.yaml
